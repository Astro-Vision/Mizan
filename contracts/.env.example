# Konfigurasi Hardhat untuk MizanFundingVault.
# Copy ke .env lalu isi. Jangan commit .env.
#
# PERINGATAN: private key di bawah TIDAK BOLEH diberi prefix NEXT_PUBLIC_
# dan tidak boleh diimpor dari kode di app/ atau components/.

# RPC BNB Smart Chain Testnet (chainId 97).
# RPC publik sering rate-limit; pakai provider sendiri untuk deploy yang stabil.
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Deployer: menerima DEFAULT_ADMIN_ROLE saat deploy.
# Juga dipakai sebagai donatur di npm run smoke:testnet.
DEPLOYER_PRIVATE_KEY=

# Role operasional WAJIB di ignition/params.bscTestnet.json, bukan env.
# Salin ignition/params.bscTestnet.example.json dan isi address nonzero.
# Jalankan npm run deploy:testnet; tidak ada fallback role ke deployer.

# Private key role untuk smoke test testnet (npm run smoke:testnet).
# Harus cocok dengan address di params.bscTestnet.json.
CAMPAIGN_MANAGER_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=

# Opsional. Default: alamat dari ignition/deployments/chain-97.
# VAULT_ADDRESS=0xE8e0eE10f620464d9CD475c6A2Ba9dC13B9623de

# Untuk verify contract di BscScan.
BSCSCAN_API_KEY=
