// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model AuditLogs {
    id          Uuid                         @id(map: "audit_logs_pkey") @default(dbgenerated("gen_random_uuid()"))
    pantiId     String?                      @map("panti_id")
    notaNumber  String?                      @map("nota_number")
    totalAmount Numeric?                     @map("total_amount")
    status      String?
    reason      String?
    embedding   Unsupported("vector(3072)")?
    createdAt   Timestamptz?                 @default(now()) @map("created_at")
    content     String?
    metadata    Jsonb?

    @@rls
    @@map("audit_logs")
  }

  model Campaign {
    id            Int         @id(map: "campaign_pkey") @default(autoincrement())
    createdAt     Timestamptz @default(now())
    donatur       Int         @default(0)
    judul         String
    penyelenggara String
    satuan        String      @default("BNB")
    status        String      @default("menunggu")
    target        Float
    terkumpul     Float       @default(0)
    updatedAt     Timestamptz

    @@map("campaign")
  }

  model User {
    id                          Int          @id(map: "user_pkey") @default(autoincrement())
    createdAt                   Timestamptz  @default(now())
    email                       String?      @unique(map: "user_email_key")
    name                        String?
    updatedAt                   Timestamptz
    username                    String?      @unique(map: "user_username_key")
    privyId                     String       @unique(map: "user_privyId_key")
    avatarUrl                   String?
    role                        String       @default("USER")
    dataConsent                 Boolean      @default(false)
    dataConsentAt               Timestamptz?
    dataConsentVersion          String?
    domicile                    String?
    onboardingCompletedAt       Timestamptz?
    referralSource              String?
    referralSourceOther         String?
    userType                    String?
    whatsappNotificationConsent Boolean      @default(false)
    whatsappNumber              String?
    posts                       Post[]
    userWallets                 UserWallet[]

    @@check(expression: "(role = ANY (ARRAY['USER'::text, 'ADMIN'::text, 'BENEFACTOR'::text, 'BENEFACTORY'::text]))", map: "user_role_check_758453b1")
    @@map("user")
  }

  model Post {
    id        Int         @id(map: "post_pkey") @default(autoincrement())
    authorId  Int
    content   String?
    createdAt Timestamptz @default(now())
    title     String
    updatedAt Timestamptz
    author    User        @relation(fields: [authorId], references: [id], map: "post_authorId_fkey")

    @@index([authorId], name: "post_authorId_idx")
    @@map("post")
  }

  model UserWallet {
    id            Int         @id(map: "userWallet_pkey") @default(autoincrement())
    userId        Int
    address       String
    chainType     String
    walletType    String
    privyWalletId String?     @unique(map: "userWallet_privyWalletId_key")
    createdAt     Timestamptz @default(now())
    updatedAt     Timestamptz
    user          User        @relation(fields: [userId], references: [id], map: "userWallet_userId_fkey")

    @@unique([address, chainType], map: "userWallet_address_chainType_key")
    @@index([userId], name: "userWallet_userId_idx")
    @@map("userWallet")
  }

  policy_insert langflow {
    target = AuditLogs
    roles = [anon, authenticated]
    withCheck = "true"
    @@map("langflow")
  }
}
