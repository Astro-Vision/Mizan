// use prisma-next

model User {
  id        Int          @id @default(autoincrement())
  privyId   String       @unique
  email     String?      @unique
  username  String?      @unique
  name      String?
  avatarUrl String?
  role      Role         @default(USER)
  userType  String?
  domicile  String?
  whatsappNumber String?
  whatsappNotificationConsent Boolean @default(false)
  referralSource String?
  referralSourceOther String?
  dataConsent Boolean @default(false)
  dataConsentAt TimestamptzString?
  dataConsentVersion String?
  onboardingCompletedAt TimestamptzString?
  posts     Post[]
  wallets   UserWallet[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model UserWallet {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id])
  userId        Int
  address       String
  chainType     String
  walletType    String
  privyWalletId String?  @unique
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@unique([address, chainType])
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum Role {
  USER
  ADMIN
  BENEFACTOR
  BENEFACTORY
}

types {
  Embedding3072 = pgvector.Vector(3072)
}

model Campaign {
  id             Int              @id @default(autoincrement())
  judul          String
  penyelenggara  String
  terkumpul      Float            @default(0)
  target         Float
  satuan         String           @default("BNB")
  donatur        Int              @default(0)
  status         String           @default("menunggu")
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model AuditLogs {
  id           Uuid          @id @default(uuid())
  panti_id     String?
  nota_number  String?
  total_amount Decimal?
  status       String?
  reason       String?
  embedding    Embedding3072?
  created_at   TimestamptzString? @default(now())
  content      String?
  metadata     Jsonb?

  @@map("audit_logs")
  @@control(observed)
  @@rls
}

policy_insert audit_logs_langflow {
  target = AuditLogs
  roles = [anon, authenticated]
  withCheck = "true"
  @@map("langflow")
}
