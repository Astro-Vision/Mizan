// use prisma-next

model User {
  id        Int          @id @default(autoincrement())
  privyId   String       @unique
  email     String?      @unique
  username  String?      @unique
  name      String?
  avatarUrl String?
  role      Role         @default(USER)
  userType  String?
  domicile  String?
  whatsappNumber String?
  whatsappNotificationConsent Boolean @default(false)
  referralSource String?
  referralSourceOther String?
  dataConsent Boolean @default(false)
  dataConsentAt TimestamptzString?
  dataConsentVersion String?
  onboardingCompletedAt TimestamptzString?
  posts     Post[]
  wallets   UserWallet[]
  communities Community[]
  approvedCampaigns Campaign[] @relation("CampaignApprover")
  campaignPayments CampaignPayment[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model UserWallet {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id])
  userId        Int
  address       String
  chainType     String
  walletType    String
  privyWalletId String?  @unique
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@unique([address, chainType])
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum Role {
  USER
  ADMIN
  BENEFACTOR
  BENEFACTORY
}

types {
  Embedding3072 = pgvector.Vector(3072)
}

model Campaign {
  id             Int              @id @default(autoincrement())
  judul          String
  penyelenggara  String
  community      Community?       @relation(fields: [communityId], references: [id])
  communityId    Int?
  source         CampaignSource   @default(AI_MOCK)
  aiDraft        Json?
  aiReference    String?
  aiConfidence   Float?
  reviewStatus   CampaignReviewStatus @default(AI_DRAFT)
  approvedBy     User?            @relation("CampaignApprover", fields: [approvedById], references: [id])
  approvedById   Int?
  approvedAt     TimestamptzString?
  rejectionReason String?
  recipientWallet String?
  targetAmountWei String           @default("0")
  contractCampaignId String?
  contractTransactionHash String?
  payments       CampaignPayment[]
  terkumpul      Float            @default(0)
  target         Float
  satuan         String           @default("BNB")
  donatur        Int              @default(0)
  status         String           @default("menunggu")
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model Community {
  id                 Int                        @id @default(autoincrement())
  name               String
  owner              User                       @relation(fields: [ownerId], references: [id])
  ownerId            Int
  walletAddress      String
  chainType          String                     @default("BSC_TESTNET")
  verificationStatus CommunityVerificationStatus @default(PENDING)
  campaigns          Campaign[]
  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()

  @@unique([walletAddress, chainType])
  @@index([ownerId])
}

model CampaignPayment {
  id              Int           @id @default(autoincrement())
  campaign        Campaign      @relation(fields: [campaignId], references: [id])
  campaignId      Int
  donor           User          @relation(fields: [donorId], references: [id])
  donorId         Int
  donorWallet     String
  amountWei       String
  mode            PaymentMode   @default(MOCK)
  status          PaymentStatus @default(PENDING)
  transactionHash String?
  idempotencyKey  String        @unique
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([campaignId])
  @@index([donorId])
}

enum CampaignSource {
  AI_MOCK
}

enum CampaignReviewStatus {
  AI_DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CommunityVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentMode {
  MOCK
  ONCHAIN
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

model AuditLogs {
  id           Uuid          @id @default(uuid())
  panti_id     String?
  nota_number  String?
  total_amount Decimal?
  status       String?
  reason       String?
  embedding    Embedding3072?
  created_at   TimestamptzString? @default(now())
  content      String?
  metadata     Jsonb?

  @@map("audit_logs")
  @@control(observed)
  @@rls
}

policy_insert audit_logs_langflow {
  target = AuditLogs
  roles = [anon, authenticated]
  withCheck = "true"
  @@map("langflow")
}

// 

model Source {
  id              String     @id @default(uuid())

  name            String
  sourceType      SourceType
  dataFormats     DataFormats
  baseUrlOrHandle String

  isOfficial      Boolean    @default(false)
  isActive        Boolean    @default(true)

  createdAt       TimestamptzString @default(now())

  rawCaptures     RawCapture[]

  @@index([sourceType])
}

enum SourceType {
  OFFICIAL // BMK, BNPB, BMKG, etc
  NEWS
  SOCIAL_MEDIA 
}

enum DataFormats {
  JSON
  RSS
  HTML
  OTHERS
}


// =================================
// RAW CAPTURE
// =================================

model RawCapture {
  id                String   @id @default(uuid())

  sourceId          String
  source            Source   @relation(
    fields: [sourceId],
    references: [id]
  )

  url               String?

  authorName        String?
  authorVerified    Boolean  @default(false)

  contentText       String

  mediaUrls         Json?
  engagementMetrics Json?

  publishedAt       TimestamptzString?

  capturedAt        TimestamptzString @default(now())

  contentHash       String   @unique

  analysis          Analysis?

  @@index([sourceId])
  @@index([capturedAt])
}


// =================================
// AI ANALYSIS
// =================================

model Analysis {
  id                String   @id @default(uuid())

  rawCaptureId      String   @unique

  rawCapture        RawCapture @relation(
    fields: [rawCaptureId],
    references: [id]
  )

  isDisaster        Boolean

  disasterType      DisasterType?

  confidenceScore   Float

  extractedLocation Json?

  eventId           String?

  event             DisasterEvent? @relation(
    fields: [eventId],
    references: [id]
  )

  createdAt        TimestamptzString @default(now())

  updatedAt         temporal.updatedAtString()

  @@index([eventId])
}


// =================================
// DISASTER EVENT
// =================================

model DisasterEvent {
  id                String @id @default(uuid())

  disasterType      DisasterType?

  title             String

  description       String?
  
  validationStatus  ValidationStatus @default(UNVERIFIED)

  locationName      String?
  province          String?
  capitalCity       String?

  officialConfirmed Boolean @default(false)

  firstDetectedAt   TimestamptzString @default(now())

  lastUpdatedAt     temporal.updatedAtString()

  analyses          Analysis[]

  @@index([validationStatus])
  @@index([disasterType])
}


// =================================
// ENUM
// =================================

enum SeverityLevel {
  RENDAH
  SEDANG
  TINGGI
  KRITIS
}

enum DisasterType {
  GEMPA_BUMI // bnpb & bmkg
  BANJIR // bnpb & bpbd
  TANAH_LONGSOR // bnpb & bpbd
  KARHUTLA  // bnpb & bpbd 
  TSUNAMI // bnpb & bmkg
  ERUPSI_GUNUNG_API // bnpb & bmkg
  KEKERINGAN // bnpb
  LAINNYA // bnpb
}

enum ValidationStatus {
  UNVERIFIED
  CORROBORATED
  OFFICIAL_CONFIRMED
  REJECTED
}


model ScrapeJob {
  id String @id @default(uuid())

  startDate TimestamptzString
  endDate   TimestamptzString

  status ScrapeJobStatus @default(PENDING)

  totalSources  Int @default(0)
  processedData Int @default(0)

  startedAt  TimestamptzString?
  completedAt TimestamptzString?

  errorMessage String?

  createdAt TimestamptzString @default(now())

  @@index([status])
}

enum ScrapeJobStatus {
  PENDING
  PLANNING
  SCRAPING
  ANALYZING
  COMPLETED
  FAILED
}
